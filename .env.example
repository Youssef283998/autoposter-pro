# AutoPoster Pro — SECRETS ONLY.
# Copy this file to .env, fill in what you need, and keep it private:
#   chmod 600 .env          (Unix/macOS)
#   icacls .env /inheritance:r /grant:r "%USERNAME%:R"   (Windows, adjust as needed)
#
# Behavior settings (timezones, retries, rate caps) live in config.yaml, not here.
# Leave unused keys blank. Never commit the real .env file.

# ---------------------------------------------------------------------------
# Encryption key (required for storing OAuth tokens at rest)
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, AutoPoster generates a key on first run and stores it in
# <data_dir>/.encryption_key with owner-only permissions.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Telegram (easy — BotFather bot token)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Discord (easy — bot token and/or webhook URL)
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Mastodon (easy — per-instance application token)
# Created by: autoposter setup mastodon
# ---------------------------------------------------------------------------
MASTODON_API_BASE=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
MASTODON_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Bluesky (easy — account handle + app password from Bluesky settings)
# ---------------------------------------------------------------------------
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ---------------------------------------------------------------------------
# X / Twitter (medium — requires an approved developer app and API plan)
# OAuth 2.0 PKCE tokens are written here by: autoposter setup x
# ---------------------------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_TOKEN_EXPIRES_AT=

# ---------------------------------------------------------------------------
# LinkedIn (hard — requires an approved developer app + product permissions)
# OAuth 2.0 tokens are written here by: autoposter setup linkedin
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_TOKEN_EXPIRES_AT=
LINKEDIN_PERSON_URN=
LINKEDIN_ORG_URN=

# ---------------------------------------------------------------------------
# Optional failure alerts
# ---------------------------------------------------------------------------
# SMTP email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Telegram alert destination (requires TELEGRAM_BOT_TOKEN above)
ALERT_TELEGRAM_CHAT_ID=

# Generic webhook (POSTs JSON)
ALERT_WEBHOOK_URL=

# Password gate for the local web dashboard when you bind it beyond 127.0.0.1
WEB_PASSWORD=
